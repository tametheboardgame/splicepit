{
  "name": "splicepit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SplicePit browser RPG",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node scripts/run-tests.mjs",
    "build": "vite build",
    "smoke": "node scripts/browser-smoke.mjs",
    "verify": "npm run typecheck && npm run validate:content && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
